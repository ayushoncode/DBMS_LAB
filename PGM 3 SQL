-- DISPLAY TABLES

SELECT * FROM Sailor;
SELECT * FROM Boat;
SELECT * FROM Reserves;

-- 1) DETAILS OF BOATS RESERVED BY #Sailor_Name

SELECT B.*
FROM Boat B
JOIN Reserves R ON B.BID = R.BID
JOIN Sailor S ON R.SailorID = S.SailorID
WHERE S.Sailor_Name = 'Ram';

-- GENERIC EXAM VERSION
-- WHERE S.Sailor_Name = '#Sailor_Name';

-- 2) BID OF BOATS RESERVED BY ALL SAILORS

SELECT BID
FROM Reserves
GROUP BY BID
HAVING COUNT(DISTINCT SailorID) = (
    SELECT COUNT(*) FROM Sailor
);

-- 3) NUMBER OF BOATS RESERVED BY EACH SAILOR

SELECT S.Sailor_Name, COUNT(R.BID) AS Number_Of_Boats
FROM Sailor S
LEFT JOIN Reserves R ON S.SailorID = R.SailorID
GROUP BY S.Sailor_Name;
