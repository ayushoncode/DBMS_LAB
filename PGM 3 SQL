-- CREATE TABLES

CREATE TABLE Sailor (
    SailorID VARCHAR(10) PRIMARY KEY,
    Sailor_Name VARCHAR(50),
    Age INT,
    Rating INT
);

CREATE TABLE Boat (
    BID VARCHAR(10) PRIMARY KEY,
    BName VARCHAR(50),
    Color VARCHAR(20)
);

CREATE TABLE Reserves (
    SailorID VARCHAR(10),
    BID VARCHAR(10),
    ReserveDate DATE,
    PRIMARY KEY (SailorID, BID, ReserveDate),
    FOREIGN KEY (SailorID) REFERENCES Sailor(SailorID),
    FOREIGN KEY (BID) REFERENCES Boat(BID)
);

