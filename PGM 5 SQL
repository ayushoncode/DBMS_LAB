-- DISPLAY TABLES

SELECT * FROM Books;
SELECT * FROM Student;
SELECT * FROM Borrows;

-- 1) STUDENTS WHO BORROWED ISBN 123 OR 124

SELECT DISTINCT S.SName
FROM Student S
JOIN Borrows B ON S.SID = B.SID
WHERE B.ISBN IN ('123', '124');

-- 2) FEMALE STUDENTS WHO BORROWED DATABASE BOOKS

SELECT DISTINCT S.SName
FROM Student S
JOIN Borrows B ON S.SID = B.SID
JOIN Books BK ON B.ISBN = BK.ISBN
WHERE S.Gender = 'Female'
AND BK.Title LIKE '%Database%';

-- 3) NUMBER OF BOOKS BORROWED BY EACH STUDENT

SELECT S.SID, S.SName, S.Gender, S.Address, COUNT(B.ISBN) AS Number_Of_Books
FROM Student S
LEFT JOIN Borrows B ON S.SID = B.SID
GROUP BY S.SID, S.SName, S.Gender, S.Address;
