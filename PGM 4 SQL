-- DISPLAY TABLES

SELECT * FROM customer;
SELECT * FROM branch;
SELECT * FROM account;
SELECT * FROM transactions;

-- 1) CUSTOMERS HAVING BOTH SAVINGS AND CURRENT ACCOUNT

SELECT C.*
FROM customer C
JOIN account A ON C.cid = A.cid
WHERE A.atype IN ('Savings', 'Current')
GROUP BY C.cid, C.cname, C.caddress
HAVING COUNT(DISTINCT A.atype) = 2;

-- 2) BRANCH DETAILS AND NUMBER OF ACCOUNTS

SELECT B.bid, B.bname, B.blocation, COUNT(A.ano) AS Number_Of_Accounts
FROM branch B
LEFT JOIN account A ON B.bid = A.bid
GROUP BY B.bid, B.bname, B.blocation;

-- 3) CUSTOMERS WHO PERFORMED AT LEAST 3 TRANSACTIONS

SELECT C.*
FROM customer C
JOIN account A ON C.cid = A.cid
JOIN transactions T ON A.ano = T.ano
GROUP BY C.cid, C.cname, C.caddress
HAVING COUNT(T.tid) >= 3;

-- 4) BRANCHES HAVING ACCOUNT COUNT LESS THAN AVERAGE

SELECT B.bid, B.bname, B.blocation
FROM branch B
JOIN account A ON B.bid = A.bid
GROUP BY B.bid, B.bname, B.blocation
HAVING COUNT(A.ano) < (
    SELECT AVG(AccountCount)
    FROM (
        SELECT COUNT(ano) AS AccountCount
        FROM account
        GROUP BY bid
    ) X
);
