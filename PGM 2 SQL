-- 1) OBTAIN DETAILS OF PARTS SUPPLIED BY SUPPLIER #SNAME

SELECT P.*
FROM Part P
JOIN Supply SP ON P.PID = SP.PID
JOIN Supplier S ON SP.SID = S.SID
WHERE S.SNAME = 'ABC Suppliers';

-- 2) OBTAIN NAMES OF SUPPLIERS WHO SUPPLY #PNAME

SELECT S.SNAME
FROM Supplier S
JOIN Supply SP ON S.SID = SP.SID
JOIN Part P ON SP.PID = P.PID
WHERE P.PNAME = 'Bolt';

-- 3) DELETE PARTS IN #PCOLOR

DELETE FROM Part
WHERE PCOLOR = 'Blue';

