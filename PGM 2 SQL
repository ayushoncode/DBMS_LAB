-- CREATE TABLES

CREATE TABLE Supplier (
    SID VARCHAR(10) PRIMARY KEY,
    SNAME VARCHAR(50),
    SADDR VARCHAR(100)
);

CREATE TABLE Part (
    PID VARCHAR(10) PRIMARY KEY,
    PNAME VARCHAR(50),
    PCOLOR VARCHAR(20)
);

CREATE TABLE Supply (
    SID VARCHAR(10),
    PID VARCHAR(10),
    Quantity INT,
    PRIMARY KEY (SID, PID),
    FOREIGN KEY (SID) REFERENCES Supplier(SID),
    FOREIGN KEY (PID) REFERENCES Part(PID)
);

